---
import Moden from '../../Scene3D/ModenScene/Main3D';
import BuyOrApplyFree from '../../global/BuyOrApplyFree.astro';

---
<section id="#bestinternet">

	
	<main>
		<div class="columna-izquierda" >

			
				<div class="gradient-text">Nuestra Red Social Interdiocesana</div>
				<div class="subtitle">Un lugar de todos para todos</div>
				<p class="description">Los tiempos cambian y debemos adaptarnos. Como Iglesia, colaboramos con instituciones mexicanas para crear una iniciativa de conexión y formación en línea. Únete seleccionando una institución y registrándote.</p>
			
			<div class=" botones flex flex-row content-start max-md:justify-center">
				<BuyOrApplyFree/>
			</div>
			
		</div>

	
				<img class="imagen" src="/image/paloma_adorno_out2.png" alt="">
		
		
	</main>
</section>
		  
	<style>


	
		section{
		
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-left: clamp(0px, 5vw, 100px);
			padding-right: clamp(0px, 5vw, 100px);
			margin-bottom: 100px;
			height: 90vh;
			width: 100vw;

		}
		main {
		display: flex;
		flex-direction: row;
		width: 100%;
		height: 100%;
		gap: 50px;
		}
		.columna-izquierda{
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 50px;
			max-width: 50%;
			max-height: 90vh;
			border: 10px solid transparent;
 			padding: 50px;
	/* 		background-color: rgb(248, 9, 9); */
			border-radius: 500px 500px 0px 0px;
			
			border: 5px solid #b4820eb3;
/* 		border-image: url("/image/frames/borde1.png") 10% round; */
		background-image: url("/image/textures/texture6.png");
		background-repeat: no-repeat;
		background-size: cover;
		background-position: center;
		mask-image: url("/image/textures/texture6.png");
  		mask-clip: border-box;
		padding-top: 80px;
		
		
		}

	
			.description{
				font-family: var(--font-family-secondary);
			}
			.gradient-text{
				font-size: clamp(40px, 5vw, 45px);
			font-weight: 800;
		
			text-align: center;
			
			text-wrap: pretty;
			max-width: 500px;
			align-self: center;
			color: var(--secondary-text-color);
			}
	
			.subtitle{
				color: var(--primary-text-color);
			font-size: clamp(40px, 5vw, 45px);
			font-weight: 400;
				
			text-align: center;
			
			text-wrap: balance;
			}
		
		  
	
			

			.imagen{
			width: 100%;
			height: 100%;
			border-radius: 25px;
	/* 		border:  10px solid var(--primary-color);
			border-image: url("/image/frames/borde1.png") 10% round;
 */
			
			}
			
			.description {
			  color: var(--primary-text-color);
			  font-weight: 300;
			  text-wrap: pretty;
			  font-size: clamp(1rem, 3vw, 2rem);
			}

			.cta-text {
			  justify-content: center;
			  color: var(--primary-text-color);
			  text-align: center;
			  align-self: center;
			  font-size: clamp(14px, 1.5vw, 1.5rem);
			  font-weight: 200;
			}
	
			@media (max-width: 900px) {
				main {
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				}
				.columna-izquierda{
					max-width: 100%;
					max-height: 100%;
					padding-top: 100px;
				}
			.moden{
			width: 100%;
			height: clamp(280px, 50vw, 500px);
	
			}
			.title, .best, .subtitle, .description, .cta-text{
				text-align: center;
				align-self: center;
			}
			.botones{
				justify-content: center;
			}

			.green-ball-blured{
		position: absolute;
		top: 0;
		left: 10%;
		width: clamp(350px, 5vw, 550px);
		height: clamp(350px, 5vw, 550px);
		
	}

			}
			@media  screen and (height< 450px) {
				section{
		
				
					margin-bottom: clamp(200px, 50vh, 300px);
				}
				.moden{
		
			height: clamp(150px, 50vw, 400px);
	
			}
			}
			
	
 </style>